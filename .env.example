# PostScope logging mode: single setting for the whole app
# ─────────────────────────────────────────────────────────────────────────────
# on     - Logging ON: every collection is saved to app storage automatically.
# hybrid - Internal deploy: users choose incognito or shared app history.
# off    - Public / logging OFF: incognito only, nothing stored on the app.
# Defaults to off only when LOGGING_MODE is not set in the environment.
LOGGING_MODE=off

# Public landing page: when enabled, `/` is the marketing homepage and the
# analyzer lives at `/analyze`. Disable for internal team deployments.
# Accepts: true | false | yes | no | 1 | 0 | on | off
PUBLIC_LANDING_PAGE=false

# External footer links in the analyzer sidebar.
# Set either visibility flag to false for private/internal deployments where
# outbound links should not be shown. FEEDBACK_URL must be an http(s) URL.
SHOW_GITHUB_LINK=true
SHOW_FEEDBACK_LINK=true
FEEDBACK_URL=https://github.com/winksen/Postscope-App/issues/new

# ─────────────────────────────────────────────────────────────────────────────
# Optional hardening (all off/default when unset). See docs/SECURITY.md.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP Basic auth for the whole app (except /api/health). Set BOTH to enable.
# Use a long random password and serve PostScope over HTTPS when enabled.
# BASIC_AUTH_USER=postscope
# BASIC_AUTH_PASSWORD=change-me-to-a-long-random-value
# LOGGING_MODE=hybrid or on refuses to start without both values above, unless this isolated-network override is set:
# ALLOW_UNAUTHENTICATED_TEAM_STORAGE=false

# Shared library storage (LOGGING_MODE=on|hybrid)
# DATA_DIR=./data                  # where library/ is stored
# MAX_COLLECTION_MB=15             # largest collection accepted (max 100)
# LIBRARY_MAX_ITEMS=0              # keep only the newest N collections (0 = unlimited)
# LIBRARY_RETENTION_DAYS=0         # delete collections older than N days (0 = forever)
# LIBRARY_MAX_TOTAL_MB=0           # reject saves beyond this total size (0 = unlimited)
# LIBRARY_ALLOW_DELETE=true        # false keeps an audit trail (no removal from the UI/API)
# LIBRARY_REDACT_SECRETS=false     # true scrubs credentials server-side before storing
# LIBRARY_ENCRYPTION_KEY=          # 32 bytes as 64 hex characters or base64: encrypts stored collections (AES-256-GCM)
# LIBRARY_ENCRYPTION_KEY_FILE=     # read the key from a file instead (Docker/Kubernetes secrets)
# LIBRARY_ENCRYPTION_KEY_PREVIOUS= # older keys (comma separated) that may still decrypt records during rotation
# LIBRARY_AUDIT_LOG=true           # append-only log of saves, opens and removals in DATA_DIR/audit
# TRUSTED_USER_HEADER=             # header set by your SSO proxy (X-Forwarded-User, X-Auth-Request-Email); needs TRUST_PROXY=true and TRUSTED_PROXY_PEERS
# TRUSTED_PROXY_PEERS=             # proxy socket addresses allowed to assert a user, for example 10.0.0.0/8,::1

# Rate limits per client IP (0 disables a limit)
# RATE_LIMIT_WRITES_PER_MIN=30
# RATE_LIMIT_READS_PER_MIN=600
# RATE_LIMIT_AUTH_FAILURES=20      # failed Basic auth attempts per 15 minutes

# Reverse proxy / TLS
# TRUST_PROXY=false                # true: use X-Forwarded-For / X-Forwarded-Host
# TRUST_PROXY_HOPS=1               # trusted proxies in front of the app; the client IP is that many entries from the right of X-Forwarded-For
# HEALTH_EXPOSE_VERSION=true       # false: /api/health no longer reports the version (the endpoint is public)
# ENABLE_HSTS=false                # true only when served exclusively over HTTPS
# ALLOWED_ORIGINS=                 # extra origins allowed to save/delete (comma-separated)

# Team audit policy defaults (users can still customize in their browser)
# AUDIT_DISABLED_RULES=GET_WITH_BODY
# AUDIT_SEVERITY_OVERRIDES=INSECURE_HTTP=critical,MISSING_AUTH=info
# AUDIT_RULE_PACKS=auto                 # auto (default), none, or a list such as iam-am,-iam-pam (a leading - switches a pack off)

# Score weights (points per finding severity before scaling by affected requests; 0 to 100 each)
# SCORE_WEIGHTS=critical=20,warning=8,info=2

# Server
# PORT=3010
# HOST=0.0.0.0
# LOG_LEVEL=info                   # debug | info | warn | error
# LOG_FORMAT=text                  # text | json
# ACCESS_LOG=false                 # true logs method, path, status, duration (never bodies)
