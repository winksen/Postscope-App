          "request": {
            "method": "POST",
            "url": "https://example-tenant.okta.com/oauth2/default/v1/token",
            "description": "Token with a client secret in the body. Sample request for PostScope identity checks.",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "scope",
                  "value": "okta.users.manage"
                }
              ]
            }
          },
          "response": []
