{
  "info": {
    "name": "IAM sample: access management",
    "description": "OAuth 2.0, OpenID Connect, JWT and SAML requests on fictional tenants, with the mistakes PostScope looks for. Every value is made up.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "clientSecret",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authorization code",
      "item": [
        {
          "name": "Authorize without PKCE or state",
          "request": {
            "method": "GET",
            "url": "https://example-tenant.okta.com/oauth2/default/v1/authorize?response_type=code&client_id=0oasamplespa0001&redirect_uri=https%3A%2F%2Fapp.sample-widgets.net%2Fcallback&scope=openid%20profile",
            "description": "Authorize without PKCE or state. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        },
        {
          "name": "Authorize with PKCE",
          "request": {
            "method": "GET",
            "url": "https://example-tenant.okta.com/oauth2/default/v1/authorize?response_type=code&client_id=0oasamplespa0002&redirect_uri=https%3A%2F%2Fapp.sample-widgets.net%2Fcallback&scope=openid%20profile&state={{state}}&code_challenge={{codeChallenge}}&code_challenge_method=S256",
            "description": "Authorize with PKCE. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        },
        {
          "name": "Authorize with an unsafe redirect",
          "request": {
            "method": "GET",
            "url": "https://example-tenant.okta.com/oauth2/default/v1/authorize?response_type=code&client_id=0oasamplespa0003&redirect_uri=http%3A%2F%2Fapp.sample-widgets.net%2Fcallback%3Fnext%3Dhttps%3A%2F%2Fother.sample-widgets.net&state={{state}}&code_challenge={{codeChallenge}}&code_challenge_method=S256",
            "description": "Authorize with an unsafe redirect. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        },
        {
          "name": "Authorize with the implicit grant",
          "request": {
            "method": "GET",
            "url": "https://example-tenant.okta.com/oauth2/default/v1/authorize?response_type=token&client_id=0oasamplespa0004&redirect_uri=https%3A%2F%2Fapp.sample-widgets.net%2Fcallback&state={{state}}",
            "description": "Authorize with the implicit grant. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        },
        {
          "name": "Callback with a code in the URL",
          "request": {
            "method": "GET",
            "url": "https://app.sample-widgets.net/callback?code=SampleAuthorizationCode0000&state={{state}}",
            "description": "Callback with a code in the URL. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tokens",
