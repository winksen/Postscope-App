{
  "info": {
    "name": "IAM sample: provisioning and governance",
    "description": "SCIM provisioning, joiner mover leaver requests, access requests and certifications on fictional systems. Every value is made up.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SCIM",
      "item": [
        {
          "name": "List all users",
          "request": {
            "method": "GET",
            "url": "https://scim.sample-widgets.net/scim/v2/Users",
            "description": "List all users. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "url": "https://scim.sample-widgets.net/scim/v2/Users",
            "description": "Create user. Sample request for PostScope identity checks.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"sample.user\",\n  \"name\": {\n    \"givenName\": \"Sample\",\n    \"familyName\": \"User\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Grant an administrator role",
          "request": {
            "method": "PATCH",
            "url": "https://scim.sample-widgets.net/scim/v2/Users/{{userId}}",
            "description": "Grant an administrator role. Sample request for PostScope identity checks.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/scim+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:api:messages:2.0:PatchOp\"\n  ],\n  \"Operations\": [\n    {\n      \"op\": \"add\",\n      \"path\": \"roles\",\n      \"value\": [\n        {\n          \"value\": \"Domain Admins\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Bulk delete",
          "request": {
            "method": "POST",
            "url": "https://scim.sample-widgets.net/scim/v2/Bulk",
            "description": "Bulk delete. Sample request for PostScope identity checks.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/scim+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schemas\": [\n    \"urn:ietf:params:scim:api:messages:2.0:BulkRequest\"\n  ],\n  \"Operations\": [\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/Users/{{userId}}\"\n    },\n    {\n      \"method\": \"DELETE\",\n      \"path\": \"/Users/{{otherUserId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Joiner mover leaver",
      "item": [
        {
