            "url": "https://example-tenant.okta.com/api/v1/users?activate=false",
            "description": "Create account. Sample request for PostScope identity checks.",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"login\": \"{{login}}\",\n    \"email\": \"{{email}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update department",
