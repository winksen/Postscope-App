        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "url": "https://example-tenant.okta.com/api/v1/users/{{userId}}",
            "description": "Delete account. Sample request for PostScope identity checks.",
            "header": []
          },
          "response": []
        }
      ]
    },
    {
      "name": "Access requests and reviews",
      "item": [
        {
          "name": "Request access for yourself",
          "request": {
            "method": "POST",
            "url": "https://example-tenant.api.identitynow.com/v3/access-requests",
            "description": "Request access for yourself. Sample request for PostScope identity checks.",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestedFor\": [\n    \"sample.user\"\n  ],\n  \"requestedBy\": \"sample.user\",\n  \"approver\": \"sample.user\",\n  \"requestedItems\": [\n    {\n      \"type\": \"ENTITLEMENT\",\n      \"id\": \"{{entitlementId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Approve a whole review",
          "request": {
            "method": "POST",
            "url": "https://example-tenant.api.identitynow.com/v3/certifications/{{certificationId}}/decide",
            "description": "Approve a whole review. Sample request for PostScope identity checks.",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"item-1\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-2\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-3\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-4\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-5\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-6\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-7\",\n    \"decision\": \"APPROVE\"\n  },\n  {\n    \"id\": \"item-8\",\n    \"decision\": \"APPROVE\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
