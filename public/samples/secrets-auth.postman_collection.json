{
  "info": {
    "name": "PostScope Secrets and Auth Sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "sample-secrets-auth-001"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://secure-api.example.com" },
    { "key": "bearerToken", "value": "" },
    { "key": "oauthClientId", "value": "client-demo-id" }
  ],
  "item": [
    {
      "name": "API Key Auth",
      "item": [
        {
          "name": "Get Projects",
          "request": {
            "method": "GET",
            "auth": { "type": "apikey" },
            "header": [{ "key": "X-API-Key", "value": "sk_live_12345_EXPOSED_KEY" }],
            "url": "{{baseUrl}}/projects",
            "description": "Hardcoded API key for demo"
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "auth": { "type": "apikey" },
            "header": [{ "key": "X-API-Key", "value": "sk_live_12345_EXPOSED_KEY" }],
            "url": "{{baseUrl}}/projects",
            "body": { "mode": "raw", "raw": "{\"name\":\"Secret Ops\"}" }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "auth": { "type": "apikey" },
            "url": "{{baseUrl}}/projects/9"
          }
        }
      ]
    },
    {
      "name": "Basic Auth",
      "item": [
        {
          "name": "Basic Login",
          "request": {
            "method": "POST",
            "auth": { "type": "basic" },
            "header": [{ "key": "Authorization", "value": "Basic YWRtaW46U3VwZXJTZWNyZXQ=" }],
            "url": "{{baseUrl}}/auth/basic-login",
            "body": { "mode": "raw", "raw": "{\"scope\":\"all\"}" }
          }
        },
        {
          "name": "Get Legacy Accounts",
          "request": {
            "method": "GET",
            "auth": { "type": "basic" },
            "url": "{{baseUrl}}/legacy/accounts"
          }
        },
        {
          "name": "Patch Legacy User",
          "request": {
            "method": "PATCH",
            "auth": { "type": "basic" },
            "url": "{{baseUrl}}/legacy/users/1",
            "body": { "mode": "raw", "raw": "{\"state\":\"active\"}" }
          }
        }
      ]
    },
    {
      "name": "Bearer Auth",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer" },
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Rotate Secret",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer" },
            "header": [{ "key": "Authorization", "value": "Bearer token-hardcoded-super-secret" }],
            "url": "{{baseUrl}}/secrets/rotate",
            "body": { "mode": "raw", "raw": "{\"client_secret\":\"prod_client_secret_xyz\"}" }
          }
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer" },
            "url": "{{baseUrl}}/sessions"
          }
        },
        {
          "name": "Terminate Session",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer" },
            "url": "{{baseUrl}}/sessions/sess_123"
          }
        }
      ]
    },
    {
      "name": "OAuth2",
      "item": [
        {
          "name": "Token Exchange",
          "request": {
            "method": "POST",
            "auth": { "type": "oauth2" },
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": "{{baseUrl}}/oauth/token",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "{{oauthClientId}}" },
              { "key": "client_secret", "value": "oauth-super-secret-plain" }
            ] }
          }
        },
        {
          "name": "OAuth UserInfo",
          "request": {
            "method": "GET",
            "auth": { "type": "oauth2" },
            "url": "{{baseUrl}}/oauth/userinfo"
          }
        },
        {
          "name": "OAuth Revoke",
          "request": {
            "method": "POST",
            "auth": { "type": "oauth2" },
            "url": "{{baseUrl}}/oauth/revoke",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "token", "value": "{{bearerToken}}" }
            ] }
          }
        }
      ]
    },
    {
      "name": "JWT + NoAuth Mix",
      "item": [
        {
          "name": "Public Metadata",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/public/metadata"
          }
        },
        {
          "name": "Issue JWT",
          "request": {
            "method": "POST",
            "auth": { "type": "jwt" },
            "url": "{{baseUrl}}/jwt/issue"
          }
        },
        {
          "name": "Verify JWT",
          "request": {
            "method": "POST",
            "auth": { "type": "jwt" },
            "url": "{{baseUrl}}/jwt/verify"
          }
        }
      ]
    }
  ]
}
