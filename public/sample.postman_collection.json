{
  "info": {
    "name": "Sample API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "sample-123"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com" },
    { "key": "apiKey", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "sk_live_abc123hardcoded" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"SuperSecret123\"}"
            },
            "url": "https://api.example.com/prod/login",
            "description": "Authenticate user"
          }
        },
        {
          "name": "Get Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Basic YWRtaW46cGFzc3dvcmQxMjM=" }
            ],
            "url": "{{baseUrl}}/auth/token",
            "description": "Obtain JWT token"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/users",
            "description": "List all users"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [],
            "url": "https://staging.example.com/users",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test\",\"email\":\"test@example.com\"}"
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"client_secret\":\"my_secret_value\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/1",
            "description": "Fetch single product"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "https://api.example.com/products/1",
            "header": []
          }
        }
      ]
    }
  ]
}
